views:
  - type: cards
    name: Tabella
    filters:
      and:
        - Materia == "Architettura degli elaboratori"
        - not:
            - file.basename == "Formulario e sigle"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - Imparato
      - tags
    sort:
      - property: Ordine
        direction: ASC
