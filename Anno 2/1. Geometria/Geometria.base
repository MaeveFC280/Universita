views:
  - type: cards
    name: Tabella
    filters:
      and:
        - Materia.contains("Geometria")
        - not:
            - file.inFolder("EXTRA")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - tags
      - Imparato
    sort:
      - property: Ordine
        direction: ASC
